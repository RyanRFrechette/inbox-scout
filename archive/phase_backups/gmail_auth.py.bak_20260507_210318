from pathlib import Path

from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google_auth_oauthlib.flow import InstalledAppFlow
from googleapiclient.discovery import build
from rich.console import Console

from inbox_scout.paths import CREDENTIALS_DIR, PROJECT_ROOT

console = Console()

SCOPES = ["https://www.googleapis.com/auth/gmail.readonly"]

CREDENTIALS_FILE = CREDENTIALS_DIR / "credentials.json"
TOKEN_FILE = PROJECT_ROOT / "token.json"


def get_gmail_service():
    creds = None

    if TOKEN_FILE.exists():
        creds = Credentials.from_authorized_user_file(str(TOKEN_FILE), SCOPES)

    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            console.print("[yellow]Refreshing Gmail token...[/yellow]")
            creds.refresh(Request())
        else:
            if not CREDENTIALS_FILE.exists():
                raise FileNotFoundError(
                    f"Missing credentials file: {CREDENTIALS_FILE}"
                )

            console.print("[cyan]Opening browser for Gmail read-only permission...[/cyan]")
            flow = InstalledAppFlow.from_client_secrets_file(
                str(CREDENTIALS_FILE),
                SCOPES
            )
            creds = flow.run_local_server(port=0, timeout_seconds=600)

        TOKEN_FILE.write_text(creds.to_json(), encoding="utf-8")

    return build("gmail", "v1", credentials=creds)


def test_gmail_profile():
    service = get_gmail_service()

    profile = service.users().getProfile(userId="me").execute()

    console.print("\n[bold green]Gmail read-only connection successful.[/bold green]")
    console.print(f"Email: {profile.get('emailAddress')}")
    console.print(f"Total messages: {profile.get('messagesTotal')}")
    console.print(f"Total threads: {profile.get('threadsTotal')}")
    console.print("\n[yellow]No emails were read. No Gmail changes were made.[/yellow]\n")


if __name__ == "__main__":
    test_gmail_profile()
