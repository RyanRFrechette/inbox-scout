# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# Environment variables
.env

# OAuth tokens (all scopes — never commit)
token.json
token_modify.json
token_settings.json
tokens/

# Gmail OAuth credentials
credentials/
credentials/*.json

# Model routing settings (local overrides — not committed)
config/model_settings.json
config/llm_pending_action.json

# Telegram config and state (contains bot tokens and chat IDs)
config/telegram_config.json
config/telegram_config.before_phase13t_*.json
config/telegram_listener_state.json

# Runtime data — email metadata and personal data
data/logs/
data/plans/
data/review_queue/
data/raw/
data/history/
data/reports/
data/exports/

# Lock file
requirements.lock.txt

# Claude Code local state (memory, settings)
.claude/
