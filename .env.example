APP_NAME=Inbox Scout
APP_MODE=local
DEFAULT_EMAIL_LIMIT=25

# --- AI provider (local only, never commit real values) ---
OPENROUTER_API_KEY=          # Your OpenRouter API key — set locally, never commit

# --- Cloud deployment (Render) ---
# Set these as environment secrets in the Render dashboard. Never commit values.
TELEGRAM_BOT_TOKEN=          # Atlas bot token from @BotFather
TELEGRAM_CHAT_ID=            # Your Telegram chat ID (numeric)
GMAIL_TOKEN_JSON=            # base64-encoded contents of token.json
