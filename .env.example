APP_NAME=Inbox Scout
APP_MODE=local
DEFAULT_EMAIL_LIMIT=25

# --- AI provider ---
# Set locally in .env or as a cloud env secret. Never commit values.
OPENROUTER_API_KEY=          # Your OpenRouter API key (optional — falls back to local/rule-based)

# --- Telegram bot ---
# Set locally in .env or as cloud env secrets. Never commit values.
TELEGRAM_BOT_TOKEN=          # Atlas bot token from @BotFather
TELEGRAM_CHAT_ID=            # Your Telegram chat ID (numeric)

# --- Gmail OAuth tokens (cloud deployment only) ---
# On local dev, token.json and token_modify.json are on disk — leave these blank.
# On cloud (Render/Railway/Fly), base64-encode your token files and set here:
#
#   PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("token.json")) | clip
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("token_modify.json")) | clip
#
#   Linux/macOS:
#     base64 -w 0 token.json
#     base64 -w 0 token_modify.json
#
# Set these as secrets in the Render/Railway dashboard. Never commit values.
GMAIL_TOKEN_JSON=            # base64-encoded contents of token.json (readonly scope)
GMAIL_TOKEN_MODIFY_JSON=     # base64-encoded contents of token_modify.json (modify scope)
